<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>InvoiceMaster</RootNamespace>
    <AssemblyName>invoicemaster</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Bui Bao Khanh</Authors>
    <Product>invoicemaster</Product>
    <Description>Professional invoice management CLI: customers, invoices, payments, tax rules, reports and CSV export. Zero NuGet dependencies.</Description>
    <Copyright>Copyright (c) 2026 Bui Bao Khanh</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StartupObject>InvoiceMaster.Program</StartupObject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

</Project>
